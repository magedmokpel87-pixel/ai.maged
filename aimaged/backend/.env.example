# AI.MAGED backend — copy to .env and fill real values
DATABASE_URL=postgresql://aimaged:aimaged_password@localhost:5432/aimaged?schema=public
JWT_SECRET=change-to-a-long-random-string
PORT=4000
# Origin of the public frontend (used by CORS)
FRONTEND_URL=http://localhost:3000
# Where uploaded files are stored (defaults to ./uploads)
UPLOAD_DIR=./uploads
# Used only by `npx prisma db seed` to create the admin account
ADMIN_EMAIL=admin@ai.maged.local
ADMIN_PASSWORD=ChangeMe!2026
# Shared secret for n8n webhook triggers
N8N_API_KEY=replace-with-shared-secret
